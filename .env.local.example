# Supabase keys — kopieer van Supabase Dashboard → Settings → API
# Vervang deze placeholder waardes met je echte keys

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# Service-role key (alleen server-side) — nodig voor billing-routes
# (Mollie-webhook, facturatie-run). Dashboard → Settings → API.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Mollie — zonder key draait billing in demo-mode (gesimuleerde incasso).
# test_... eerst, live_... bij livegang.
MOLLIE_API_KEY=

# Secret voor het cron-endpoint POST /api/billing/run
# (Vercel Cron gebruikt automatisch CRON_SECRET als die bestaat)
BILLING_RUN_SECRET=kies-een-lang-willekeurig-secret

# Publieke site-URL — gebruikt voor Mollie redirect/webhook URLs
NEXT_PUBLIC_SITE_URL=https://www.klokworks.nl

# Hernoem dit bestand naar .env.local na het invullen
